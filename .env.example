# Catálogo proposto. Não existe loader de aplicação nesta etapa.
# Copie para .env local somente quando M1 implementar validação.
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5173
API_PORT=3000
DATABASE_URL=
REDIS_URL=
SESSION_SECRET=
# Segredos Meta são geridos por conta; nunca expor no frontend.
META_GRAPH_API_VERSION=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
ENCRYPTION_KEY=
STORAGE_ROOT=/data/media
STORAGE_TEMP_ROOT=/data/uploads
INTERNAL_FILE_MAX_BYTES=2147483648
UPLOAD_CHUNK_BYTES=8388608
# Caminhos reais do host e chave de cifragem são exclusivos do operador.
