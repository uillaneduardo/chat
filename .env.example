# Copie para .env e substitua os campos vazios antes de iniciar.
DATABASE_URL=
# Testes destrutivos exigem banco exclusivo terminado em _test.
TEST_DATABASE_URL=
PUBLIC_BASE_URL=http://localhost:3000
API_PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# 32 bytes em hexadecimal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
STORAGE_ROOT=./data/media
ENABLE_DEMO=true
# Seguro por padrão: scanner ausente mantém uploads em quarentena.
ALLOW_UNSCANNED_FILES=false
# Opcional: caminho do clamscan instalado e atualizado no host/container.
CLAMSCAN_PATH=
# Uso único pelo bootstrap; remova a senha do arquivo depois de criar o usuário.
BOOTSTRAP_COMPANY=
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Somente Docker Compose: escolha senha alfanumérica longa, diferente da conta da UI.
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
